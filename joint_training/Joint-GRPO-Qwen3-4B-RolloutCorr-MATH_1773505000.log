[36m(TaskRunner pid=439428)[0m # Calculate the expected number of regions
[36m(TaskRunner pid=439428)[0m initial_regions = 4
[36m(TaskRunner pid=439428)[0m lines_added = 25
[36m(TaskRunner pid=439428)[0m 
[36m(TaskRunner pid=439428)[0m # Calculate the sum of (n+1)/2 for n from 1 to 25
[36m(TaskRunner pid=439428)[0m expected_regions_added = sum((n + 1) / 2 for n in range(1, lines_added + 1))
[36m(TaskRunner pid=439428)[0m 
