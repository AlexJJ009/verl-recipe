[36m(TaskRunner pid=439428)[0m 
[36m(TaskRunner pid=439428)[0m // 函数mok（移动操作）用于更新座椅状态，包括前人不能立即选择的位置，和新的选择对剩余可选座位的影响。
[36m(TaskRunner pid=439428)[0m void mok(int x, int y)
[36m(TaskRunner pid=439428)[0m {
[36m(TaskRunner pid=439428)[0m     f[x] = 1;                // 标记当前位置已被选择。
[36m(TaskRunner pid=439428)[0m     for (int i = x - 1; i >= 1 && f[i] == 0; i--) {
[36m(TaskRunner pid=439428)[0m         if (i - y - 1 >= 1) {
[36m(TaskRunner pid=439428)[0m             f[i - y - 1] = 2;  // 如果当前操作与之前选择的位置之间有足够距离，标记可能的影响。
[36m(TaskRunner pid=439428)[0m         }
[36m(TaskRunner pid=439428)[0m     }
[36m(TaskRunner pid=439428)[0m     for (int i = x + 1; i <= n && f[i] == 0; i++) {
[36m(TaskRunner pid=439428)[0m         if (i + y + 1 <= n) {
[36m(TaskRunner pid=439428)[0m             f[i + y + 1] = 2;  // 同上，考虑操作对之后位置的影响。
