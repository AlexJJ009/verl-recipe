// 该程序计算8个人坐在16个位置上，满足“三个人不想坐一起”的方案数。
#include <iostream>
#include <cstring>
using namespace std;
int f[19];
int n, m;
// 函数mok（移动操作）用于更新座椅状态，包括前人不能立即选择的位置，和新的选择对剩余可选座位的影响。
void mok(int x, int y)
{
    f[x] = 1;                // 标记当前位置已被选择。
    for (int i = x - 1; i >= 1 && f[i] == 0; i--) {
        if (i - y - 1 >= 1) {
            f[i - y - 1] = 2;  // 如果当前操作与之前选择的位置之间有足够距离，标记可能的影响。
        }
    }
    for (int i = x + 1; i <= n && f[i] == 0; i++) {
        if (i + y + 1 <= n) {
            f[i + y + 1] = 2;  // 同上，考虑操作对之后位置的影响。
        }
    }
}
// 函数main实现核心逻辑，尝试通过回溯法来解决座位选择问题。
int main()
{
    // 初始化座位总数为16，已选人数为8
    n = 16;
    m = 8;
    memset(f, 0, sizeof(f));  // 清零所有座位状态。
    // 调试输出，显示初始状态。
    for(int i = 0; i <= n; i++)
        cout << f[i] << " ";
    cout << endl;
    // 开始选择座位的过程。
    int res = 1;
    for(int i = 1; i <= m; i++) {
        bool flag = true;  // 假设当前座位选择有效。
        // 尝试在座位之间留空，确保选择符合题目要求。
        for(int k = 1; k <= n - 2; k++) {
            if(f[k] == 0 && f[k + 1] == 0 && f[k + 2] == 0) {  // 检查当前位置及其后两席是否空着。
                mok(k, i);  // 记录选择该位置的影响。
                // 尝试选择下一个位置，递归调用继续选择。
                if(i < m) {
                    res = res * (i + 1);  // 更新可能的方案数。
                    flag = false;
                    break;
                } else {
                    // 计算当前有效方案数，并检查是否达到最大值。
                    int j, k = 1;
                    for(j = 1; j <= n; j++) {
                        if(f[j] == 2) {
                            k++;  // 统计被影响的位置。
                        } else if(f[j] == 1) {
                            break;  // 找到第一个已选择的位置。
                        }
                    }
                    if(k == n) {
                        cout << "选择有效" << endl;
                    } else {
                        cout << "选择无效" << endl;
                    }
                }
            }
        }
        // 如果当前选择无效，则回溯。
        if(flag) {
            int k = 1;
            for(int j = 1; j <= n; j++) {
                if(f[j] == 2) {
                    k++;
                } else if(f[j] == 1) {
                    break;
                }
            }
            f[k] = 0;  // 回到选择前的状态。
        }
    }
    // 输出最终的方案数。
    cout << res << endl;
    return 0;
}
