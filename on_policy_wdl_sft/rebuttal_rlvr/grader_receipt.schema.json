{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rebuttal RLVR reward-grader receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "path",
    "sha256",
    "function_name",
    "recipe_commit",
    "image_digest",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_kind": {"const": "latex_verify_grader"},
    "path": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "function_name": {"const": "compute_score_latex_verify"},
    "recipe_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
