#!/usr/bin/env bash
# Portable model catalog for rebuttal RLVR launchers.

ROOT=${ROOT:-/data-1}
HF_MODEL_CACHE_ROOT=${HF_MODEL_CACHE_ROOT:-"${ROOT}/.cache/huggingface"}
MODEL_ROOT=${MODEL_ROOT:-"${ROOT}/models/rebuttal_rlvr/init"}

# R01 is intentionally pre-registered before its files arrive.  A colleague
# only replaces this one directory (or overrides the variable); launch remains
# fail-closed while the named placeholder is absent.
export ORDINARY_SFT_4B_MODEL_NAME=${ORDINARY_SFT_4B_MODEL_NAME:-R01_ORDINARY_SFT_4B_AM1P4M}
export ORDINARY_SFT_4B_MODEL_PATH=${ORDINARY_SFT_4B_MODEL_PATH:-"${MODEL_ROOT}/${ORDINARY_SFT_4B_MODEL_NAME}"}
export INIT_SFT_DATASET_ID=${INIT_SFT_DATASET_ID:-AM-1.4M}
export RLVR_TRAIN_DATASET_ID=${RLVR_TRAIN_DATASET_ID:-hendrycks_math_7500}

export WDL_4B_MODEL_ID=${WDL_4B_MODEL_ID:-chhao/Weak-Driven-Learning}
export WDL_4B_REVISION=${WDL_4B_REVISION:-1bfdcc4506656288b115b8fa1d4e446f4e344f12}
export WDL_4B_MODEL_PATH=${WDL_4B_MODEL_PATH:-"${HF_MODEL_CACHE_ROOT}/models--chhao--Weak-Driven-Learning/snapshots/${WDL_4B_REVISION}"}
export WDL_4B_WEIGHT_FILE=${WDL_4B_WEIGHT_FILE:-pytorch_model.bin}
export WDL_4B_WEIGHT_BYTES=${WDL_4B_WEIGHT_BYTES:-8045067711}
export WDL_4B_WEIGHT_SHA256=${WDL_4B_WEIGHT_SHA256:-3267350ca2bc2325c24b9b7d98852b776568a759c3d13242dd3cc7db1442d6b9}

# The public repository currently documents an 8B variant but does not expose
# an 8B branch or model repository. Keep this path explicit and fail closed
# until a real repository/revision has been verified and downloaded.
export WDL_8B_MODEL_ID=${WDL_8B_MODEL_ID:-}
export WDL_8B_REVISION=${WDL_8B_REVISION:-}
export WDL_8B_MODEL_PATH=${WDL_8B_MODEL_PATH:-}

export ROOT HF_MODEL_CACHE_ROOT MODEL_ROOT
