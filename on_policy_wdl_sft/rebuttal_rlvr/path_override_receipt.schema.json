{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rebuttal RLVR parent-root layout receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "root",
    "repo_subpath",
    "repo_root",
    "model_root",
    "init_model_path",
    "train_file",
    "math7_root",
    "output_root",
    "checkpoint_root",
    "eval_root",
    "log_root",
    "wandb_root",
    "receipt_root",
    "hf_home",
    "huggingface_hub_cache",
    "hf_datasets_cache",
    "xdg_cache_home",
    "ray_tmpdir",
    "tmpdir",
    "vllm_config_root",
    "zmq_ipc_dir",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_kind": {"const": "rebuttal_parent_root_layout"},
    "root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "repo_subpath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\n\\r\\u0000]+$"},
    "repo_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "model_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "init_model_path": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "train_file": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "math7_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "output_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "checkpoint_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "eval_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "log_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "wandb_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "receipt_root": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "hf_home": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "huggingface_hub_cache": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "hf_datasets_cache": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "xdg_cache_home": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "ray_tmpdir": {"const": "/tmp/rebuttal_rlvr/ray"},
    "tmpdir": {"const": "/tmp/rebuttal_rlvr/tmp"},
    "vllm_config_root": {"const": "/tmp/rebuttal_rlvr/vllm"},
    "zmq_ipc_dir": {"const": "/tmp/rebuttal_rlvr/zmq"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
