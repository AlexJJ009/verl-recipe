#!/usr/bin/env bash
# Scientific configuration for the rebuttal MATH comparison.
#
# This file is the human-review surface. Both arms source these exact values;
# H20 calibration may change only the system knobs kept in _common_math_rlvr.sh.
# G1b v1 reconstructed the historical project-2G launcher. Human review
# rejected the historical deviations and selected current standard verl GRPO
# surfaces for the new paired comparison. Both arms consume this exact file.

export REBUTTAL_GRPO_CONFIG_VERSION="rebuttal-standard-grpo-v2"

export ADV_ESTIMATOR="grpo"
export POLICY_LOSS_MODE="vanilla"
export NORM_ADV_BY_STD_IN_GRPO="true"
export CLIP_RATIO="0.2"
export CLIP_RATIO_LOW="0.2"
export CLIP_RATIO_HIGH="0.2"
export CLIP_RATIO_C="3.0"
export LOSS_AGG_MODE="token-mean"

export OPTIMIZER_NAME="AdamW"
export OPTIMIZER_IMPL="torch.optim"
export LR="5e-7"
export WEIGHT_DECAY="0.1"
export LR_WARMUP_STEPS="5"
export LR_SCHEDULER_TYPE="constant"
export OPTIMIZER_BETAS="[0.9,0.999]"
export OPTIMIZER_EPS="1e-8"
export ZERO_INDEXED_STEP="true"
export GRAD_CLIP="1.0"
export PPO_EPOCHS="1"

export TRAIN_PROMPT_BSZ="64"
export TRAIN_PROMPT_MINI_BSZ="8"
export ROLLOUT_N="8"
export MAX_PROMPT_LENGTH="500"
export MAX_RESPONSE_LENGTH="4096"
export TEMPERATURE="1.0"
export TOP_P="1.0"
export TOP_K="-1"
export ROLLOUT_DO_SAMPLE="true"
export ACTOR_SHUFFLE="false"
export DATA_SHUFFLE="false"
export ENTROPY_COEFF="0.0"
export CALCULATE_ENTROPY="true"
export REWARD_MANAGER="naive"

export VAL_TEMPERATURE="1.0"
export VAL_TOP_P="0.95"
export VAL_TOP_K="-1"
export VAL_DO_SAMPLE="true"
export VAL_N="3"

export TOTAL_EPOCHS="1"
export TOTAL_TRAINING_STEPS="115"
export SAVE_FREQ="5"
export TEST_FREQ="5"
export VAL_BEFORE_TRAIN="true"
export KEEP_BEST_CKPT="true"
export BEST_CKPT_METRIC_KEY="val-core/HuggingFaceH4/MATH-500/acc/mean@3"
export BEST_CKPT_METRIC_MODE="max"
export BEST_CKPT_STRIP_OPTIMIZER="true"
export MAX_ACTOR_CKPTS_TO_KEEP="1"

export USE_KL_IN_REWARD="false"
export KL_COEF="0.0"
export USE_KL_LOSS="true"
export KL_LOSS_COEF="0.001"
export KL_LOSS_TYPE="low_var_kl"
export ROLLOUT_IS="null"
export ROLLOUT_IS_THRESHOLD="null"
export ROLLOUT_IS_BATCH_NORMALIZE="false"
export ROLLOUT_RS="null"
export ROLLOUT_RS_THRESHOLD="null"
export ROLLOUT_CORRECTION_BYPASS_MODE="false"
export ROLLOUT_CORRECTION_LOSS_TYPE="ppo_clip"
export JOINT_TRAINING="false"
export TRACK_JOINT_SUBMODEL_LOSSES="false"
export SUBMODEL_KL_ENABLED="false"
export ALL_CORRECT_SFT_FALLBACK="false"
