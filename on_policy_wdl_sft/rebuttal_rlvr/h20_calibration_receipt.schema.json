{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rebuttal RLVR signed H20 calibration admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "approved",
    "status",
    "approval_scope",
    "calibration_id",
    "h20_profile_path",
    "h20_profile_sha256",
    "terminal_receipts",
    "reviewer_key_id",
    "attestation_payload_path",
    "attestation_payload_sha256",
    "attestation_signature_path",
    "attestation_signature_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_kind": {"const": "h20_calibration_admission"},
    "approved": {"const": true},
    "status": {"const": "passed"},
    "approval_scope": {"const": "rebuttal-h20-common-v1"},
    "calibration_id": {"type": "string", "pattern": "^[A-Za-z0-9_+-]{1,64}$"},
    "h20_profile_path": {"$ref": "#/$defs/absolute_path"},
    "h20_profile_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sft", "wdl"],
      "properties": {
        "sft": {"$ref": "#/$defs/file_binding"},
        "wdl": {"$ref": "#/$defs/file_binding"}
      }
    },
    "reviewer_key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.@+-]+$"},
    "attestation_payload_path": {"$ref": "#/$defs/absolute_path"},
    "attestation_payload_sha256": {"$ref": "#/$defs/sha256"},
    "attestation_signature_path": {"$ref": "#/$defs/absolute_path"},
    "attestation_signature_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/[^\\n\\r\\u0000]+$"},
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
