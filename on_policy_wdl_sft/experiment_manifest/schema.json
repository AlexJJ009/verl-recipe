{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "experiment_id", "resource_profile", "semantics", "paths", "runs", "monitor", "release", "preflight", "calibration_policy", "calibration_workloads"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "resource_profile": {
      "type": "object",
      "required": ["name", "sha256", "max_response_length"],
      "properties": {
        "name": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "max_response_length": {"const": 8192}
      }
    },
    "semantics": {
      "type": "object",
      "required": ["formal_validation_scope", "validation_datasets", "validation_dataset_hashes", "sampled_decoding_semantic_hash", "scorer_hash", "timeout_policy_hash", "phase_topology_hashes", "stage2_topology"],
      "properties": {
        "formal_validation_scope": {"const": "full"},
        "validation_datasets": {"const": ["HumanEval+", "MBPP+", "LiveCodeBench"]},
        "sampled_decoding_semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scorer_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "timeout_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stage2_topology": {"const": "fixed_model2_rollout_joint_fused_loss"}
      }
    },
    "paths": {
      "type": "object",
      "required": ["checkpoint_root", "checkpoint_physical_root", "artifact_root", "scratch_root", "base_model", "stage1_init_model", "stage1_init_provenance", "source_train_file"],
      "properties": {
        "checkpoint_physical_root": {"const": "/data-2/checkpoints"}
      }
    },
    "preflight": {
      "type": "object",
      "required": ["policy", "result_max_age_seconds", "report_root"],
      "additionalProperties": false,
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "result_max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "report_root": {"type": "string", "minLength": 1}
      }
    },
    "calibration_policy": {
      "type": "object",
      "required": [
        "algorithm",
        "bootstrap_repetitions_per_phase",
        "acceptance_repetitions_per_phase",
        "validation_deadline_seconds",
        "calibration_result_max_age_seconds",
        "future_skew",
        "roots"
      ],
      "properties": {
        "algorithm": {"const": "stage123_history_conformal_v1"},
        "bootstrap_repetitions_per_phase": {"const": 6},
        "acceptance_repetitions_per_phase": {"const": 3},
        "validation_deadline_seconds": {"const": 1800},
        "calibration_result_max_age_seconds": {"const": 86400},
        "future_skew": {"const": 300},
        "roots": {
          "type": "object",
          "required": ["history", "prediction", "report"],
          "properties": {
            "history": {"type": "string", "minLength": 1},
            "prediction": {"type": "string", "minLength": 1},
            "report": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "calibration_workloads": {
      "type": "object",
      "required": ["stage1", "stage2", "stage3"],
      "additionalProperties": false,
      "properties": {
        "stage1": {"$ref": "#/$defs/calibrationWorkload"},
        "stage2": {"$ref": "#/$defs/calibrationWorkload"},
        "stage3": {"$ref": "#/$defs/calibrationWorkload"}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chain", "fraction", "phase", "order", "run_prefix", "final_step", "tmux_name", "train_file", "train_file_sha256", "source", "artifact_dir", "provenance_file"],
        "properties": {
          "phase": {"enum": ["stage2", "stage3"]},
          "final_step": {"type": "integer", "minimum": 1},
          "train_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "modelSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "state": {"enum": ["materialized", "pending"]},
        "path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "hash_algorithm": {"const": "sorted_relative_path_content_sha256_v1"},
        "provenance": {"$ref": "#/$defs/provenanceBinding"},
        "producer": {
          "type": "object",
          "required": ["run_id", "final_step", "output_path", "provenance_path"],
          "additionalProperties": false,
          "properties": {
            "run_id": {"type": "string", "minLength": 1},
            "final_step": {"const": 20},
            "output_path": {"type": "string", "minLength": 1},
            "provenance_path": {"type": "string", "minLength": 1}
          }
        }
      },
      "oneOf": [
        {
          "required": ["role", "state", "path", "artifact_sha256", "hash_algorithm"],
          "properties": {"state": {"const": "materialized"}}
        },
        {
          "required": ["role", "state", "path", "producer"],
          "properties": {"state": {"const": "pending"}},
          "not": {"anyOf": [{"required": ["artifact_sha256"]}, {"required": ["hash_algorithm"]}, {"required": ["provenance"]}]}
        }
      ]
    },
    "provenanceBinding": {
      "type": "object",
      "required": ["path", "sha256", "schema_version", "kind"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 1},
        "kind": {"enum": ["format_cold_start_source", "stage1_model2_source", "stage2_model2_source"]}
      }
    },
    "datasetDescriptor": {
      "type": "object",
      "required": ["name", "path", "sha256", "row_count", "uid_source", "difficulty_resolution", "difficulty_mapping_sha256", "difficulty_stratum_counts"],
      "additionalProperties": false,
      "properties": {
        "name": {"enum": ["HumanEval+", "MBPP+", "LiveCodeBench"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1},
        "uid_source": {"const": "parquet.extra_info.uid"},
        "difficulty_resolution": {"const": "unavailable"},
        "difficulty_mapping_sha256": {"$ref": "#/$defs/sha256"},
        "difficulty_stratum_counts": {
          "type": "object", "required": ["unstratified"], "additionalProperties": false,
          "properties": {"unstratified": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "calibrationWorkload": {
      "type": "object",
      "required": ["phase", "parameter_counter_version", "rollout_model_parameter_counts", "rollout_model_parameter_count_sum", "log2_rollout_model_parameter_count_sum", "model_provenance_class", "model_sources", "datasets", "tokenizer", "validation_eligibility", "outcome_schema_version"],
      "additionalProperties": false,
      "properties": {
        "phase": {"enum": ["stage1", "stage2", "stage3"]},
        "parameter_counter_version": {"const": "hf_qwen3_config_parameter_count_v1"},
        "rollout_model_parameter_counts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "rollout_model_parameter_count_sum": {"type": "integer", "minimum": 1},
        "log2_rollout_model_parameter_count_sum": {"type": "number", "minimum": 1},
        "model_provenance_class": {"enum": ["base_pretrained", "sft_checkpoint", "stage1_model2_handoff", "stage2_model2_handoff", "fixed_model2_joint_rollout"]},
        "model_sources": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/modelSource"}},
        "calibration_proxy": {
          "type": "object",
          "required": ["purpose", "path", "artifact_sha256", "hash_algorithm", "rollout_model_parameter_count"],
          "additionalProperties": false,
          "properties": {
            "purpose": {"const": "pending_stage2_handoff_runtime_resource_proxy"},
            "path": {"type": "string", "minLength": 1},
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "hash_algorithm": {"const": "sorted_relative_path_content_sha256_v1"},
            "rollout_model_parameter_count": {"type": "integer", "minimum": 1}
          }
        },
        "datasets": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/datasetDescriptor"}},
        "tokenizer": {
          "type": "object", "required": ["path", "config_sha256", "tokenizer_sha256"], "additionalProperties": false,
          "properties": {"path": {"type": "string", "minLength": 1}, "config_sha256": {"$ref": "#/$defs/sha256"}, "tokenizer_sha256": {"$ref": "#/$defs/sha256"}}
        },
        "validation_eligibility": {
          "type": "object",
          "required": ["max_prompt_length", "filter_enabled", "filter_implementation_sha256", "ordered_eligible_uid_sha256", "per_dataset_eligible_counts", "submitted_prompt_count"],
          "additionalProperties": false,
          "properties": {
            "max_prompt_length": {"const": 1024},
            "filter_enabled": {"const": true},
            "filter_implementation_sha256": {"$ref": "#/$defs/sha256"},
            "ordered_eligible_uid_sha256": {"$ref": "#/$defs/sha256"},
            "per_dataset_eligible_counts": {
              "type": "object", "required": ["HumanEval+", "MBPP+", "LiveCodeBench"], "additionalProperties": false,
              "properties": {"HumanEval+": {"type": "integer", "minimum": 1}, "MBPP+": {"type": "integer", "minimum": 1}, "LiveCodeBench": {"type": "integer", "minimum": 1}}
            },
            "submitted_prompt_count": {"type": "integer", "minimum": 1}
          }
        },
        "outcome_schema_version": {"const": 2}
      }
    }
  }
}
